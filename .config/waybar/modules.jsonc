// ----------------------------------------------------- 
//
{
    // Workspaces
    "hyprland/workspaces" : {
        "on-click": "activate",
        "active-only": false,
        "all-outputs": true,
        "format": "{}",
        "format-icons": {
            "urgent": "",
            "active": "",
            "default": ""
        },
        "persistent-workspaces": {
            "*": 5
        }       
    },

    // Taskbar
    "wlr/taskbar": {
        "format": "{icon}",
        "icon-size": 16,
        "tooltip": true,
        "tooltip-format": "{title}",
        "on-click": "activate",
        "on-click-middle": "close",
        "ignore-list": [
            "Alacritty"
        ],
        "app_ids-mapping": {
            "firefoxdeveloperedition": "firefox-developer-edition"
        },
        "rewrite": {
            "Firefox Web Browser": "Firefox",
            "Foot Server": "Terminal"
        }
    },

    // Hyprland Window
    "hyprland/window": {
        "rewrite": {
            "(.*) - Brave": "$1",
            "(.*) - Chromium": "$1",
            "(.*) — Zen Browser": "$1",
            "(.*) - Brave Search": "$1",
            "(.*) - Outlook": "$1",
            "(.*) Microsoft Teams": "$1",
            "vesktop": "Discord"
        },
        "separate-outputs": true,
        "max-length": 80
    },

    // Cliphist
    "custom/cliphist": {
        "format": "",
        "on-click": "sleep 0.1 && pkill wofi || ~/.config/scripts/cliphist.sh",
        "on-click-right": "sleep 0.1 && pkill wofi || ~/.config/scripts/cliphist.sh d",
        "on-click-middle": "sleep 0.1 && pkill wofi || ~/.config/scripts/cliphist.sh w",
        "tooltip": false
    },

    // Hyprshade
    "custom/hyprshade": {
        "format": "",
        "on-click": "sleep 0.1; ~/.config/hypr/scripts/hyprshade.sh",
        "on-click-right": "sleep 0.1; ~/.config/hypr/scripts/hyprshade.sh rofi",
        "tooltip": false
    },

    // Hypridle inhibitor
    "custom/hypridle": {
        "format": "",
        "return-type": "json",
        "escape": true,
        "exec-on-event": true,
        "interval": 60,
        "exec": "~/.config/hypr/scripts/hypridle.sh status",
        "on-click": "~/.config/hypr/scripts/hypridle.sh toggle",
        "on-click-right": "hyprlock"
    },


    // Power Menu
    "custom/exit": {
        "format": "",
        "on-click": "wlogout",
        "tooltip": false
    },

    // System tray
    "tray": {
        // "icon-size": 21,
        "spacing": 10
    },

    // Clock
    "clock": {
        "format": "{:%a %y-%m-%d %H:%M}",
        "on-click": "gnome-calendar",
        "tooltip": false
    },

    // CPU
    "cpu": {
        "format": "  /{usage}% ",
        "on-click": "gnome-system-monitor -r"
    },

    // Temperature
    "temperature": {
        // "thermal-zone": 2,
        // "hwmon-path": "/sys/class/hwmon/hwmon2/temp1_input",
        "critical-threshold": 80,
        // "format-critical": "{temperatureC}°C {icon}",
        "format": "{icon}/{temperatureC}°C",
        "format-icons": ["", "", ""]
    },

    // Memory
    "memory": {
        "format": " /{}% ",
        "on-click": "gnome-system-monitor -r"
    },

    // Harddisc space used
    "disk": {
        "interval": 30,
        "format": "D {percentage_used}% ",
        "path": "/",
        "on-click": "ghostty -e htop"
    }, 

    "hyprland/language": {
        "format": "{short}"
    },

    "group/stats" : {
        "orientation": "horizontal",
        "drawer": {
            "transition-duration": 300,
            "transition-left-to-right": false,
            "click-to-reveal" : true,
        },        
        "modules" : [
            "custom/drawer-placeholder",
            "cpu",
            "memory",
            "temperature",
        ],
    },

    "group/devices": {
        "orientation": "inherit",
        "modules": [
            "network",
            "custom/toggle-pia",
            "custom/separator",
            "bluetooth",
        ]
    },


    // Network
    "network": {
        "format-wifi": " ",
        "format-ethernet": " ",
        "format-disconnected": "󰌙 ", //An empty format will hide the module.
        "tooltip-format": " {ifname} via {gwaddri}",
        "tooltip-format-wifi": "   {essid} ({signalStrength}%)",
        "tooltip-format-ethernet": "  {ifname} ({ipaddr}/{cidr})",
        "tooltip-format-disconnected": "Disconnected",
        "max-length": 50,
        "on-click": "nm-connection-editor"
    },

    "group/hardware": {
        "orientation": "horizontal",
        "modules": [
            "group/stats",
            "power-profiles-daemon",
            "custom/separator",
            "backlight",
            "custom/separator",
            "battery",
            "custom/toggle-conservation",
        ]
    },
    // Battery
    "battery": {
        "states": {
            // "good": 95,
            "warning": 30,
            "critical": 15
        },
        "format": "{icon} {capacity}%",
        "format-charging": "  {capacity}%",
        "format-plugged": " {capacity}%",
        "format-alt": "{icon} {time}",
        // "format-good": "", // An empty format will hide the module
        // "format-full": "",
        "format-icons": [" ", " ", " ", " ", " "],
    },

    "custom/toggle-conservation": {
        "exec": "sleep 0.2; ~/.config/scripts/toggle-conservation.sh",
        "on-click": "sleep 0.2; ~/.config/scripts/toggle-conservation.sh toggle",
        "exec-on-event": false,
        "signal": 13,
        "tooltip": false,
        "interval": "once",
        "return-type": "json",
    },

    "custom/toggle-pia": {
        "exec": "sleep 0.2; ~/.config/scripts/toggle-pia.sh",
        "on-click": "sleep 0.2; ~/.config/scripts/toggle-pia.sh toggle",
        "exec-on-event": false,
        "signal": 14,
        "tooltip": false,
        "interval": "once",
        "return-type": "json",
    },

    // Pulseaudio
    "pulseaudio": {
        // "scroll-step": 1, // %, can be a float
        "format": "{format_source} {icon} {volume}%",
        "format-bluetooth": "{format_source} 󰂰 {volume}%",
        "format-bluetooth-muted": "{format_source} 󰝟",
        "format-muted": "{format_source} 󰝟",
        "format-source": "",
        "format-source-muted": " ",
        "format-icons": {
            "headphone": "",
            "hands-free": "",
            "headset": "",
            "phone": "",
            "portable": "",
            "car": "",
            "default": ["", " ", " "]
        },
        "on-click": "pavucontrol -t 3",
        "on-click-right": "pavucontrol -t 1",
    },

    // Bluetooth
    "bluetooth": {
        "format": "󰂯",
        "format-connected": "󰂱",
        "format-disabled": "󰂲",
        "tooltip": true,
        "tooltip-format-connected": "{device_enumerate}",
        "tooltip-format-enumerate-connected": "{device_alias}",
        // "tooltip-format-enumerate-connected-battery": "{device_alias} 󰁹{device_battery}%",
        "format-off": "󰂲",

        "interval": 30,
        "on-click": "blueman-manager",
        "format-no-controller": ""
    },

    // Idle Inhibator
    "idle_inhibitor": {
        "format": "{icon}",
        "tooltip": true,
        "format-icons": {
            "activated": "",
            "deactivated": ""
        },
        "on-click-right": "hyprlock"        
    },

    "backlight": {
        // "device": "acpi_video1",
        "format": "{icon} {percent}%",
        "tooltip-format": "Brigthness {percent}%",
        "format-icons": ["󰃞", "󰃞", "󰃟", "󰃝", "󰃠"]   
    },

    "power-profiles-daemon": {
        "format": "{icon}",
        "tooltip-format": "Power profile: {profile}\nDriver: {driver}",
        "tooltip": true,
        "format-icons": {
            "default": " ",
            "performance": " ",
            "balanced": " ",
            "power-saver": " "
        }
    },

    "custom/notification": {
        "format": "{icon}",
        "format-icons": {
            "notification": "󱅫",
            "none": "󰂚",
            "dnd-notification": "󱅫",
            "dnd-none": "󰂛",
            "inhibited-notification": "󰂚<span foreground='#DB4740'><sup></sup></span>",
            "inhibited-none": "󰂚",
            "dnd-inhibited-notification": "󰂛<span foreground='#DB4740'><sup></sup></span>",
            "dnd-inhibited-none": "󰂛"
        },
        "return-type": "json",
        "exec-if": "which swaync-client",
        "exec": "swaync-client -swb",
        "on-click": "sleep 0.1; swaync-client -t -sw",
        "on-click-right": "swaync-client -d -sw",
    },

    "custom/separator" : {
        "format" : "•",
        "tooltip": false,
    },

    "custom/drawer-placeholder" : {
        "format" : "󰄽 ",
        "tooltip": false,
    },
}
